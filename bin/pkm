#!/usr/bin/env bash
# pkm: the command line for a plain Markdown vault. Installed once per machine; no agent or editor needed.
# The vault is the folder that holds .pkm/. Commands print paths relative to the vault. Works with bash 3.2
# (macOS) and Git Bash (Windows); it expects ripgrep (rg), jq and git: pkm doctor lists them.
#
# Usage: pkm [--vault <folder>] [-V <name>] <command> [arguments]
#   day [YYYY-MM-DD] [--edit]     the day's page, daybook/<year>/<month>/<date>.md, created when missing; prints its
#                                 path. --edit opens it in $EDITOR. In a shared vault the page is <date>-<writer>.md
#   add [--day <date>] [--file <path>] <text|->
#                                 an entry at the end of the day's Log: "- HH:MM text", printed as path:line. Several lines,
#                                 or - for stdin, go under a "### HH:MM" heading, verbatim. --file copies a file to
#                                 files/<year>/<month>/<date>-<name> (never over another) and the entry links it
#   todo <text> [--due <day>] [--high | --low] [--waiting | --someday | --start <day> | --every <N>d|w|m|y or cycle [--in <note>]]
#                                 a task for today, under the Tasks section of its page. A day is YYYY-MM-DD, today, tomorrow, +3d,
#                                 +2w or a weekday. --every makes a routine: 1d, 1w, 1m or 1y, or a cycle from the settings. It goes
#                                 to the note named routines (created when missing), not to today's page, or with --in <note> to
#                                 that note's Routines section. --start hides the task
#                                 until that day; --someday keeps it out of the weekly views
#   done <words | path:line> [--drop | --next <day>]
#                                 marks the one open task that matches as done ([x]), or as dropped ([-]) with --drop.
#                                 A routine with an interval, such as (every 1m), keeps its box and moves its due date on
#                                 (--next <day>: to that day, for a routine done early or late)
#   tasks [open | waiting | someday | done [YYYY-MM-DD]] [--link <name>] [--for <who>] [--under <note>] [--stale <days>] [--all]
#                                 the open tasks of every note, in groups: overdue, due soon, waiting, the rest
#                                 (docs/contract.md gives the order). A task is a "- [ ]" line outside code
#   new <type> <title> [--name <name>]
#                                 a note in notes/ (or folder_<type> from the settings), made from its template; a type with
#                                 no template is made from the note template. An existing name fails (exit 1) and says so
#   upcoming [<days>] [--ics]     due tasks (routines too), events, birthdays, target and warranty dates in the next <days> (14);
#                                 --ics prints the events, tasks with a time and birthdays as a calendar file
#   backlinks <name> [--since YYYY-MM-DD] [--under <note>]
#                                 every line that links a note, by its file name, slug or alias, archive included, and
#                                 the lines under a ### heading that links it
#   names [--type <type>]         every note's name, type, path and aliases, by name, from the cache. Day and close pages
#                                 are left out unless --type says them: names --type person lists the people
#   index [--rebuild]             brings the cache (.pkm/cache, or PKM_CACHE_DIR) up to date and says what changed
#   rename <old> <new> [--dry-run] [--no-alias]
#                                 renames a note and rewrites every link that names it, outside code; the old name
#                                 becomes an alias unless --no-alias; --dry-run lists the changes and writes nothing
#   mv <note> <folder>            moves a note into a folder; its links keep working. Both record the move in .pkm/moves.tsv
#   path <name>                   the path of the note, attachment or alias a [[name]] link points to, archive included
#   list [<field>=<value> ...] [--show <field>,...] [--all] [--quiet <days>] [--under <note>]
#                                 notes whose frontmatter matches, from the cache: path, type, title, then the --show fields;
#                                 --quiet lists those no day page in the last <days> days links
#   overview [--json]             the shape of the vault: each area with the notes that are part_of it, then projects,
#                                 resources (courses, topics, sources) and other notes with notes under them, then the
#                                 archive's count; a line is path:<title line>: <titles from the top> (<type>, <status>)
#   find [--live] <word> [<word>...]
#                                 the lines with every word, in any order, as path:line: text. Smart case: a word
#                                 with a capital letter matches exactly. The archive is searched too, unless --live
#   tags                          every tag with its count
#   check [--urls]                broken links, duplicate names, secrets and merge conflicts (exit 1), and notices;
#                                 --urls also GETs each web address (curl, 5 s, 8 at once): no answer, 404 or 410 (exit 1)
#   get <name>[#Section] [--lines a-b]
#                                 a note, or one section (its heading to the next of the same or a higher level), between
#                                 "<<<note path lines a-b" and ">>>end"; --lines takes the note's own line numbers
#   post <path:line[-line]> <note>[#Section]
#                                 copies those lines into the section, verbatim, with " ([[page]])" after the last one,
#                                 and prints path:line; a missing section is made at the end. Refuses a heading, an open
#                                 task, or a day or close page as the target (exit 1)
#   moved <path:line> <when>      strikes a task or an event whose date changed and writes it again with the new date:
#                                 below it in a note, on today's page from another day's page, linking that day
#   strike <path:line>            wraps the line's text in ~~ and adds " ([[today's page]])", making today's page if it is
#                                 missing; refuses a blank line, a heading or a struck line (exit 1)
#   links --external [note]       each http(s) address outside code, as path:line: address (links to notes: backlinks)
#   cycle [name] [--date D]       the period of a cycle holding a date (today): name, first and last day; cycles are set in
#                                 .pkm/config as cycle_<name>=2w from <weekday|date> or cycle_<name>=1m from <day 1-28|date>
#   since [last | YYYY-MM-DD | N | cycle] [--about NAME] [--under <note>] [--limit n] [--json]
#                                 what happened since then, in sections: notes, log, tasks, marked, names; since --seen
#                                 marks where the next since last starts (.pkm/state)
#   recall [note] [--json] [--limit n]
#                                 the recall questions due today or earlier, oldest first: path:line: text. A question ends
#                                 with (recall YYYY-MM-DD <N>d); recall <path:line> yes|no moves it one rung up the ladder
#                                 (1 3 7 14 30 60 120 days), or back to 1 day
#   recall add <note> <question> [--answer <text>]...
#                                 writes a question at the end of the note's ## Questions section, marked to ask tomorrow,
#                                 with each answer indented below it; prints path:line. Refuses a day or close page, and a
#                                 question the note already has
#   close [--cycle name] [--date D] [--quarter] [--json]
#                                 the close of the period holding yesterday: tasks, open questions, due, marked, names,
#                                 quiet and ideas; new close [--cycle name] [--date D] writes its close page
#   evidence [--verify] <note | ->
#                                 each summary line (## Now, a close page whole, or stdin) must link its source (exit 1):
#                                 a day page, a source note, or path:line; --verify checks the links and lines exist
#   init                          sets up a vault in this folder, or in the one --vault names: .pkm/config, .pkm/.gitignore, .pkmignore; refuses
#                                 to overwrite any of them
#   vault                         the vault's folder
#   vaults                        the named vaults of the user config, each with ok or missing
#   config [<key>]                every setting with its value and where it comes from (vault, user or default), or one
#   templates                     each template type with where it comes from (vault, user or default)
#   templates eject <type> [--user]
#                                 copies the default template into the vault's templates folder (or the user's), and
#                                 never overwrites one (exit 1)
#   doctor                        the tools pkm uses and the settings: what is missing or wrong (exit 1)
#   version [--require <x.y>]     the pkm release; with --require, exit 0 when it is at least x.y, else 1 and no output
#   help                          this text
#   completion bash|zsh           the shell's tab completion script, for example in ~/.zshrc: source <(pkm completion zsh)
#
# Listings: find, backlinks, path, list, tasks and check take --json (JSON Lines), --abs (absolute paths) and --limit n
# (default 30). A listing with no results exits 1. docs/contract.md is the interface; pkm help --all lists the commands.
# Settings: docs/settings.md lists every key. .pkm/config is the vault's, the user's config is ~/.config/pkm/config.
# .pkmignore in the vault hides files and folders from pkm, in gitignore syntax; .gitignore is not followed.
# PKM_NOW=YYYYMMDDHHMMSS fixes the clock, for tests and for backfilling.
#
# Examples: pkm day
#           pkm todo "Send [[jane-doe]] the offer" --due friday --high
#           pkm new person "Jane Doe"
#           pkm list type=project status=active

set -u

# A range such as [a-z] or [A-Z] means ASCII letters only. In a UTF-8 locale bash 3.2 and other tools collate
# letters together, so [A-Z] matched "apollo". LC_ALL would override LC_COLLATE, so its value moves to LC_CTYPE:
# characters stay UTF-8, only the order of ranges is the C one.
if [ -n "${LC_ALL:-}" ]; then export LC_CTYPE="$LC_ALL"; unset LC_ALL; fi
export LC_COLLATE=C

# Follow symlinks to the real bin/pkm, so lib/ and share/ are found next to it, however it is put on PATH.
pkm_self=$0
while [ -L "$pkm_self" ]; do
  pkm_link=$(readlink "$pkm_self") || exit 2
  case $pkm_link in
    /*) pkm_self=$pkm_link ;;
    *) pkm_self=$(dirname "$pkm_self")/$pkm_link ;;
  esac
done
pkm_bin=$(cd "$(dirname "$pkm_self")" && pwd -P) || exit 2
pkm_home=$(cd "$pkm_bin/.." && pwd -P) || exit 2

# usage: the comment block from the "Usage:" line on, without its "# ".
usage() { awk '/^# Usage:/ { on = 1 } on && /^#/ { sub(/^# ?/, ""); print; next } on { exit }' "$pkm_bin/pkm"; }

# shellcheck source=../lib/pkm/core.sh
. "$pkm_home/lib/pkm/core.sh"
# shellcheck source=../lib/pkm/dates.sh
. "$pkm_home/lib/pkm/dates.sh"
# shellcheck source=../lib/pkm/config.sh
. "$pkm_home/lib/pkm/config.sh"
# shellcheck source=../lib/pkm/vault.sh
. "$pkm_home/lib/pkm/vault.sh"
# shellcheck source=../lib/pkm/links.sh
. "$pkm_home/lib/pkm/links.sh"
# shellcheck source=../lib/pkm/lines.sh
. "$pkm_home/lib/pkm/lines.sh"
# shellcheck source=../lib/pkm/events.sh
. "$pkm_home/lib/pkm/events.sh"
# shellcheck source=../lib/pkm/plain.sh
. "$pkm_home/lib/pkm/plain.sh"
# shellcheck source=../lib/pkm/people.sh
. "$pkm_home/lib/pkm/people.sh"
# shellcheck source=../lib/pkm/tree.sh
. "$pkm_home/lib/pkm/tree.sh"
# shellcheck source=../lib/pkm/about.sh
. "$pkm_home/lib/pkm/about.sh"
# shellcheck source=../lib/pkm/tasks.sh
. "$pkm_home/lib/pkm/tasks.sh"
# shellcheck source=../lib/pkm/index.sh
. "$pkm_home/lib/pkm/index.sh"
# shellcheck source=../lib/pkm/rename.sh
. "$pkm_home/lib/pkm/rename.sh"
# shellcheck source=../lib/pkm/cmd/rename.sh
. "$pkm_home/lib/pkm/cmd/rename.sh"
# shellcheck source=../lib/pkm/cmd/mv.sh
. "$pkm_home/lib/pkm/cmd/mv.sh"
# shellcheck source=../lib/pkm/cmd/names.sh
. "$pkm_home/lib/pkm/cmd/names.sh"
# shellcheck source=../lib/pkm/cmd/index.sh
. "$pkm_home/lib/pkm/cmd/index.sh"
# shellcheck source=../lib/pkm/cmd/check.sh
. "$pkm_home/lib/pkm/cmd/check.sh"
# shellcheck source=../lib/pkm/cmd/config.sh
. "$pkm_home/lib/pkm/cmd/config.sh"
# shellcheck source=../lib/pkm/daybook.sh
. "$pkm_home/lib/pkm/daybook.sh"
# shellcheck source=../lib/pkm/cmd/add.sh
. "$pkm_home/lib/pkm/cmd/add.sh"
# shellcheck source=../lib/pkm/cmd/day.sh
. "$pkm_home/lib/pkm/cmd/day.sh"
# shellcheck source=../lib/pkm/cmd/doctor.sh
. "$pkm_home/lib/pkm/cmd/doctor.sh"
# shellcheck source=../lib/pkm/cmd/done.sh
. "$pkm_home/lib/pkm/cmd/done.sh"
# shellcheck source=../lib/pkm/cmd/evidence.sh
. "$pkm_home/lib/pkm/cmd/evidence.sh"
# shellcheck source=../lib/pkm/cmd/get.sh
. "$pkm_home/lib/pkm/cmd/get.sh"
# shellcheck source=../lib/pkm/cmd/post.sh
. "$pkm_home/lib/pkm/cmd/post.sh"
# shellcheck source=../lib/pkm/cmd/moved.sh
. "$pkm_home/lib/pkm/cmd/moved.sh"
# shellcheck source=../lib/pkm/cmd/strike.sh
. "$pkm_home/lib/pkm/cmd/strike.sh"
# shellcheck source=../lib/pkm/cmd/links.sh
. "$pkm_home/lib/pkm/cmd/links.sh"
# shellcheck source=../lib/pkm/sections.sh
. "$pkm_home/lib/pkm/sections.sh"
# shellcheck source=../lib/pkm/cycles.sh
. "$pkm_home/lib/pkm/cycles.sh"
# shellcheck source=../lib/pkm/state.sh
. "$pkm_home/lib/pkm/state.sh"
# shellcheck source=../lib/pkm/cmd/cycle.sh
. "$pkm_home/lib/pkm/cmd/cycle.sh"
# shellcheck source=../lib/pkm/digest.sh
. "$pkm_home/lib/pkm/digest.sh"
# shellcheck source=../lib/pkm/cmd/since.sh
. "$pkm_home/lib/pkm/cmd/since.sh"
# shellcheck source=../lib/pkm/cmd/close.sh
. "$pkm_home/lib/pkm/cmd/close.sh"
# shellcheck source=../lib/pkm/recall.sh
. "$pkm_home/lib/pkm/recall.sh"
# shellcheck source=../lib/pkm/cmd/recall.sh
. "$pkm_home/lib/pkm/cmd/recall.sh"
# shellcheck source=../lib/pkm/output.sh
. "$pkm_home/lib/pkm/output.sh"
# shellcheck source=../lib/pkm/extensions.sh
. "$pkm_home/lib/pkm/extensions.sh"
# shellcheck source=../lib/pkm/cmd/completion.sh
. "$pkm_home/lib/pkm/cmd/completion.sh"
# shellcheck source=../lib/pkm/cmd/help.sh
. "$pkm_home/lib/pkm/cmd/help.sh"
# shellcheck source=../lib/pkm/cmd/find.sh
. "$pkm_home/lib/pkm/cmd/find.sh"
# shellcheck source=../lib/pkm/cmd/init.sh
. "$pkm_home/lib/pkm/cmd/init.sh"
# shellcheck source=../lib/pkm/cmd/backlinks.sh
. "$pkm_home/lib/pkm/cmd/backlinks.sh"
# shellcheck source=../lib/pkm/cmd/overview.sh
. "$pkm_home/lib/pkm/cmd/overview.sh"
# shellcheck source=../lib/pkm/cmd/list.sh
. "$pkm_home/lib/pkm/cmd/list.sh"
# shellcheck source=../lib/pkm/cmd/new.sh
. "$pkm_home/lib/pkm/cmd/new.sh"
# shellcheck source=../lib/pkm/cmd/path.sh
. "$pkm_home/lib/pkm/cmd/path.sh"
# shellcheck source=../lib/pkm/cmd/tags.sh
. "$pkm_home/lib/pkm/cmd/tags.sh"
# shellcheck source=../lib/pkm/cmd/tasks.sh
. "$pkm_home/lib/pkm/cmd/tasks.sh"
# shellcheck source=../lib/pkm/cmd/templates.sh
. "$pkm_home/lib/pkm/cmd/templates.sh"
# shellcheck source=../lib/pkm/cmd/todo.sh
. "$pkm_home/lib/pkm/cmd/todo.sh"
# shellcheck source=../lib/pkm/cmd/upcoming.sh
. "$pkm_home/lib/pkm/cmd/upcoming.sh"
# shellcheck source=../lib/pkm/cmd/vault.sh
. "$pkm_home/lib/pkm/cmd/vault.sh"
# shellcheck source=../lib/pkm/cmd/version.sh
. "$pkm_home/lib/pkm/cmd/version.sh"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/pkm.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT

# Options before the command say which vault to use. help, version, init, vaults, doctor and completion work outside a
# vault.
vault_option="" vault_name=""
while [ $# -gt 0 ]; do
  case $1 in
    --vault) [ $# -ge 2 ] || die 2 "--vault needs a folder"; vault_option=$2; shift 2 ;;
    -V) [ $# -ge 2 ] || die 2 "-V needs a vault name"; vault_name=$2; shift 2 ;;
    *) break ;;
  esac
done

command=${1:-help}
[ $# -gt 0 ] && shift
# Tab completion reads the words as typed, vault options included, and never fails a Tab press.
if [ "$command" = __complete ]; then cmd_complete "$@"; exit 0; fi
if is_builtin "$command"; then check_options "$command" "$@"; fi
case "$command" in
  help|-h|--help|version|--version|init|vaults|doctor|completion) ;;
  *) { find_vault && cd "$vault"; } || exit 2 ;;
esac

case $command in
  day) cmd_day "$@" ;;
  add) cmd_add "$@" ;;
  todo) cmd_todo "$@" ;;
  new) if [ "${1:-}" = close ]; then shift; new_close "$@"; else cmd_new "$@"; fi ;;
  done) cmd_done "$@" ;;
  tasks) output_command tasks "$@" ;;
  upcoming) cmd_upcoming "$@" ;;
  backlinks) output_command backlinks "$@" ;;
  path) output_command path "$@" ;;
  list) output_command list "$@" ;;
  overview) cmd_overview "$@" ;;
  names) output_command names "$@" ;;
  index) cmd_index "$@" ;;
  rename) cmd_rename "$@" ;;
  mv) cmd_mv "$@" ;;
  find) output_command find "$@" ;;
  tags) cmd_tags ;;
  check) output_command check "$@" ;;
  evidence) cmd_evidence "$@" ;;
  cycle) cmd_cycle "$@" ;;
  since) cmd_since "$@" ;;
  close) cmd_close "$@" ;;
  recall)
    case ${1:-} in
      add) cmd_recall "$@" ;;
      *) output_command recall "$@" ;;
    esac ;;
  get) cmd_get "$@" ;;
  post) cmd_post "$@" ;;
  strike) cmd_strike "$@" ;;
  moved) cmd_moved "$@" ;;
  links) output_command links "$@" ;;
  doctor) cmd_doctor ;;
  init) cmd_init ;;
  vault) cmd_vault ;;
  vaults) cmd_vaults ;;
  config) cmd_config "$@" ;;
  templates) cmd_templates "$@" ;;
  version|--version) cmd_version "$@" ;;
  help|-h|--help) cmd_help "$@" ;;
  completion) cmd_completion "$@" ;;
  *) run_extension "$command" "$@"
     echo "Unknown command: $command" >&2; usage >&2; exit 2 ;;
esac
